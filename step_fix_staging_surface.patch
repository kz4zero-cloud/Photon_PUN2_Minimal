+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using ExitGames.Client.Photon;
+using Newtonsoft.Json;
+using Photon.Pun;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+
+// LoadingShell に入ったMasterが、ルームの gm_plan / gm_index を見て
+// 次のステージを PhotonNetwork.LoadLevel するだけの小さな自動化。
+// Console/HUDは使わない（notes.txt へ最小限の記録のみ）。
+public class LoadingShellAutoLoader : MonoBehaviour
+{
+    private static bool _hooked;
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
+    private static void Hook()
+    {
+        if (_hooked) return;
+        _hooked = true;
+        SceneManager.sceneLoaded += OnSceneLoaded;
+    }
+
+    private static void OnSceneLoaded(Scene scene, LoadSceneMode mode)
+    {
+        if (scene.name != StagingKeys.LOADING_SHELL) return;
+        var go = new GameObject("LoadingShellAutoLoader");
+        DontDestroyOnLoad(go);
+        go.AddComponent<LoadingShellAutoLoader>().Kick();
+    }
+
+    private void Kick()
+    {
+        // Masterだけが号令を出す
+        if (!PhotonNetwork.IsMasterClient) return;
+
+        try
+        {
+            var room = PhotonNetwork.CurrentRoom;
+            if (room == null) return;
+
+            var json = room.CustomProperties?[StagingKeys.RP_PLAN] as string;
+            if (string.IsNullOrEmpty(json)) return;
+
+            var plan = JsonConvert.DeserializeObject<List<string>>(json) ?? new List<string>();
+            if (plan.Count == 0) return;
+
+            var idx  = 0;
+            if (room.CustomProperties.ContainsKey(StagingKeys.RP_INDEX))
+            {
+                var v = room.CustomProperties[StagingKeys.RP_INDEX];
+                if (v is int i) idx = i;
+            }
+            idx = Mathf.Clamp(idx, 0, plan.Count - 1);
+            var next = plan[idx];
+
+            // 状態反映
+            var hash = new Hashtable {
+                { StagingKeys.RP_SCENE, next },
+                { StagingKeys.RP_STATE, StagingKeys.ST_RUNNING }
+            };
+            room.SetCustomProperties(hash);
+
+            PhotonNetwork.AutomaticallySyncScene = true;
+            PhotonNetwork.LoadLevel(next);
+            Note($"LoadingShell->Load '{next}' (idx={idx})");
+        }
+        catch (Exception ex)
+        {
+            Note("AutoLoaderError: " + ex.Message);
+        }
+    }
+
+    private static void Note(string msg)
+    {
+        try
+        {
+            var dir = Path.Combine(Application.persistentDataPath, "diag");
+            if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
+            File.AppendAllText(Path.Combine(dir, "notes.txt"),
+                $"{DateTime.UtcNow:yyyy-MM-dd HH:mm:ss.fffZ} [AutoLoader] {msg}\n", Encoding.UTF8);
+        }
+        catch { }
+    }
+}
