+using UnityEngine;
+
+// ルーム/プレイヤープロパティのキーを一元管理（V2）。
+public static class StagingKeys
+{
+    // RoomProps
+    public const string RP_PLAN  = "gm_plan";   // JSON配列 ["Game_Proto", ...]
+    public const string RP_INDEX = "gm_index";  // int 現在のインデックス
+    public const string RP_SCENE = "gm_scene";  // string 現在/次にロードすべきシーン名
+    public const string RP_STATE = "gm_state";  // "waiting" / "loading" / "running"
+
+    // PlayerProps
+    public const string PP_READY = "ready";     // bool
+
+    // 状態定数
+    public const string ST_WAITING = "waiting";
+    public const string ST_LOADING = "loading";
+    public const string ST_RUNNING = "running";
+
+    // 経由シーン（固定）
+    public const string LOADING_SHELL = "LoadingShell";
+}
diff --git a/Assets/Scripts/Net/GameFlowV2/PunStagingFlow_Shim.cs b/Assets/Scripts/Net/GameFlowV2/PunStagingFlow_Shim.cs
new file mode 100644
