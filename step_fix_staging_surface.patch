@@ -0,0 +240 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using ExitGames.Client.Photon;
+using Newtonsoft.Json;
+using Photon.Pun;
+using Photon.Realtime;
+using UnityEngine;
+
+// 既存コードが呼ぶ "PunStagingFlow" まわりのAPIを受け止め、
+// ここで一元的に RoomProperties を更新 / シーン遷移を実施する。
+// 既存ファイルは書き換えず、拡張メソッドで差し替える。
+public static class PunStagingFlow_Shim
+{
+    // ---- 既存UIなどから呼ばれる想定の面 ----
+    // 例: flow.SetPlanOnly(list); flow.SetPlanAndStart(list); flow.SetReadyFromUI(true);
+
+    public static void SetPlanOnly(this PunStagingFlow _ignored, List<string> plan)
+    {
+        if (!PhotonNetwork.InRoom) return;
+        if (!PhotonNetwork.IsMasterClient) return; // PlanはMasterが決める
+        var json = JsonConvert.SerializeObject(plan ?? new List<string>());
+        var hash = new Hashtable {
+            { StagingKeys.RP_PLAN,  json },
+            { StagingKeys.RP_INDEX, 0     },
+            { StagingKeys.RP_SCENE, StagingKeys.LOADING_SHELL },
+            { StagingKeys.RP_STATE, StagingKeys.ST_WAITING }
+        };
+        PhotonNetwork.CurrentRoom.SetCustomProperties(hash);
+        Note("SetPlanOnly", $"plan={json}");
+    }
+
+    public static void SetPlanAndStart(this PunStagingFlow flow, List<string> plan)
+    {
+        flow.SetPlanOnly(plan);
+        // Master自身をReadyにして、全員Readyなら開始を試みる
+        flow.SetReadyFromUI(true);
+        flow.TryStartByReady();
+    }
+
+    public static void SetReadyFromUI(this PunStagingFlow _ignored, bool isReady)
+    {
+        if (!PhotonNetwork.InRoom) return;
+        var me = PhotonNetwork.LocalPlayer;
+        me.SetCustomProperties(new Hashtable { { StagingKeys.PP_READY, isReady } });
+        Note("SetReadyFromUI", $"ready={isReady}");
+    }
+
+    public static void TryStartByReady(this PunStagingFlow _ignored)
+    {
+        if (!PhotonNetwork.InRoom || !PhotonNetwork.IsMasterClient) return;
+        if (!AllPlayersReady()) return;
+        var room = PhotonNetwork.CurrentRoom;
+        if (!room.CustomProperties.ContainsKey(StagingKeys.RP_PLAN)) return;
+
+        // AutoSync を必ず有効に
+        PhotonNetwork.AutomaticallySyncScene = true;
+
+        // 状態を "loading" にして LoadingShell へ
+        var hash = new Hashtable {
+            { StagingKeys.RP_STATE, StagingKeys.ST_LOADING },
+            { StagingKeys.RP_SCENE, StagingKeys.LOADING_SHELL }
+        };
+        room.SetCustomProperties(hash);
+
+        SafeLoadLevel(StagingKeys.LOADING_SHELL, "TryStartByReady");
+    }
+
+    // ---- 内部ヘルパ ----
+
+    private static bool AllPlayersReady()
+    {
+        var list = PhotonNetwork.PlayerList;
+        foreach (var p in list)
+        {
+            var props = p.CustomProperties;
+            if (!(props != null && props.ContainsKey(StagingKeys.PP_READY) && props[StagingKeys.PP_READY] is bool b && b))
+                return false;
+        }
+        return list.Length > 0;
+    }
+
+    private static void SafeLoadLevel(string scene, string reason)
+    {
+        try
+        {
+            PhotonNetwork.LoadLevel(scene);
+            Note("LoadLevel", $"scene={scene} reason={reason}");
+        }
+        catch (Exception ex)
+        {
+            Note("LoadLevelError", ex.Message);
+        }
+    }
+
+    private static void Note(string tag, string msg)
+    {
+        // Console/HUDは禁止：ファイルにだけ書く
+        try
+        {
+            var dir = Path.Combine(Application.persistentDataPath, "diag");
+            if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
+            File.AppendAllText(Path.Combine(dir, "notes.txt"),
+                $"{DateTime.UtcNow:yyyy-MM-dd HH:mm:ss.fffZ} [{tag}] {msg}\n", Encoding.UTF8);
+        }
+        catch { }
+    }
+}
