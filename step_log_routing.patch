@@ -0,0 +1,109 @@
+using System;
+using UnityEngine;
+
+/// <summary>
+/// Unity の全 Debug.Log/Warning/Error をデスクトップ配下に自動ミラーするグローバルロガー。
+/// - Application.logMessageReceivedThreaded にフック
+/// - 出力先: C:\Users\...\Desktop\game\デバッグログ\unity_capture.log
+/// - Console/HUDを見なくてもファイルで全て追える
+/// </summary>
+public static class GlobalFileLogger
+{
+    private static bool _installed;
+    private const string CaptureFile = "unity_capture.log";
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.SubsystemRegistration)]
+    private static void Subsystem()
+    {
+        Install();
+        // 起動印を一度だけ
+        SafeWrite($"[boot] subsystem PID={System.Diagnostics.Process.GetCurrentProcess().Id}");
+    }
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
+    private static void BeforeScene()
+    {
+        Install();
+        var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene().name;
+        SafeWrite($"[boot] beforeSceneLoad scene={scene}");
+    }
+
+    private static void Install()
+    {
+        if (_installed) return;
+        _installed = true;
+        try
+        {
+            Application.logMessageReceivedThreaded -= OnLog;
+            Application.logMessageReceivedThreaded += OnLog;
+        }
+        catch { /* ignore */ }
+    }
+
+    private static void OnLog(string condition, string stackTrace, LogType type)
+    {
+        try
+        {
+            var line = $"[{type}] {condition}";
+            if (type == LogType.Exception) line += " " + stackTrace;
+            SafeWrite(line);
+        }
+        catch { /* ignore */ }
+    }
+
+    private static void SafeWrite(string line)
+    {
+        try
+        {
+            var path = FileLog.PathFor(CaptureFile);
+            FileLog.AppendRaw(path, line);
+        }
+        catch { /* ignore */ }
+    }
+}
