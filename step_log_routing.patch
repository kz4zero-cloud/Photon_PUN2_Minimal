+using System;
+using System.IO;
+using System.Text;
+using UnityEngine;
+
+/// <summary>
+/// すべてのログの既定出力先をデスクトップの「game\\デバッグログ」に統一するための軽量ヘルパ。
+/// - FileLog.Append("category", "message") で category.log に追記
+/// - FileLog.PathFor("name") で任意ファイルパスを取得
+/// - Console/HUD には依存しない
+/// </summary>
+public static class FileLog
+{
+    // 既定のルート（ユーザ指定）
+    public static readonly string Root =
+        Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory), "game", "デバッグログ");
+
+    private static readonly object _lock = new object();
+    private static bool _inited;
+
+    private static void Ensure()
+    {
+        if (_inited) return;
+        Directory.CreateDirectory(Root);
+        _inited = true;
+    }
+
+    public static string PathFor(string name)
+    {
+        Ensure();
+        return Path.Combine(Root, name);
+    }
+
+    public static void Append(string category, string line)
+    {
+        Ensure();
+        var path = Path.Combine(Root, $"{category}.log");
+        AppendRaw(path, line);
+    }
+
+    public static void AppendRaw(string path, string line)
+    {
+        Ensure();
+        var ts = DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss.fff");
+        var payload = $"{ts} {line}\n";
+        lock (_lock)
+        {
+            using var fs = new FileStream(path, FileMode.Append, FileAccess.Write, FileShare.ReadWrite);
+            using var sw = new StreamWriter(fs, new UTF8Encoding(false));
+            sw.Write(payload);
+        }
+    }
+}
diff --git a/Assets/Scripts/Debug/GlobalFileLogger.cs b/Assets/Scripts/Debug/GlobalFileLogger.cs
