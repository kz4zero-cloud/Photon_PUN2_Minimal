+using UnityEngine;
+using Photon.Pun;
+
+/// <summary>
+/// シーンに依存せず、起動直後に「安定したステージング面」を用意するブートストラップ。
+/// - GameObject "GameFlow" を自動生成（DontDestroyOnLoad）
+/// - PunStagingFlow_Shim と LoadingShellAutoLoader を必ずアタッチ
+/// - PhotonNetwork.AutomaticallySyncScene を有効化
+/// 画面/HUDやConsoleに依存しない安定実行のための土台です。
+/// </summary>
+public static class BootstrapShimLoader
+{
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
+    private static void EnsureStableSurface()
+    {
+        // 1) "GameFlow" を確保
+        var surfaceGo = GameObject.Find("GameFlow");
+        if (surfaceGo == null)
+        {
+            surfaceGo = new GameObject("GameFlow");
+            Object.DontDestroyOnLoad(surfaceGo);
+        }
+
+        // 2) PunStagingFlow_Shim を必ず載せる
+        var shim = Object.FindObjectOfType<PunStagingFlow_Shim>();
+        if (shim == null)
+        {
+            shim = surfaceGo.GetComponent<PunStagingFlow_Shim>();
+            if (shim == null) shim = surfaceGo.AddComponent<PunStagingFlow_Shim>();
+        }
+
+        // 3) LoadingShellAutoLoader を必ず載せる
+        var auto = Object.FindObjectOfType<LoadingShellAutoLoader>();
+        if (auto == null)
+        {
+            auto = surfaceGo.GetComponent<LoadingShellAutoLoader>();
+            if (auto == null) auto = surfaceGo.AddComponent<LoadingShellAutoLoader>();
+        }
+
+        // 4) シーン自動同期をON
+        PhotonNetwork.AutomaticallySyncScene = true;
+    }
+}
