+using UnityEngine;
+using Photon.Pun;
+
+// NOTE:
+//  - Domain Reload 無効でも確実に起動するよう RuntimeInitializeOnLoadMethod を2つ使う
+//  - すでにシーンに存在していれば何もしない（重複生成防止）
+//  - コンソール/HUDは一切出しません
+//
+// 必要前提: Assets/Scripts/Net/GameFlowV2/PunStagingFlow_Shim.cs が既に存在していること
+
+namespace Net.GameFlowV2
+{
+    public static class BootstrapShimLoader
+    {
+        // SubsystemRegistration: Editor再生のたびに静的状態がクリアされる層
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.SubsystemRegistration)]
+        private static void SubsystemRegistration() { /* noop (将来の拡張用) */ }
+
+        // BeforeSceneLoad: 最も早いタイミングで常駐オブジェクトを用意する
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
+        private static void BeforeSceneLoad()
+        {
+            // 同期ロードを明示的に有効
+            PhotonNetwork.AutomaticallySyncScene = true;
+
+            // 既に存在すれば何もしない
+            if (Object.FindObjectOfType<PunStagingFlow_Shim>() != null)
+            {
+                return;
+            }
+
+            // 常駐の GameFlow (Shim) を生成
+            var go = new GameObject("GameFlow (Shim)");
+            Object.DontDestroyOnLoad(go);
+            go.AddComponent<PunStagingFlow_Shim>();
+        }
+    }
+}
