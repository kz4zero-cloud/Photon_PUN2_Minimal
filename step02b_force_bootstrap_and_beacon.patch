+using System.IO;
+using UnityEngine;
+using Photon.Pun;
+
+// 正しい名前空間: Net.GameFlow2
+namespace Net.GameFlow2
+{
+    /// <summary>
+    /// 起動直後に「安定したステージング面」を必ず用意する。
+    /// - DontDestroyOnLoad("GameFlow") を生成
+    /// - PunStagingFlow_Shim と LoadingShellAutoLoader を必ずアタッチ
+    /// - PhotonNetwork.AutomaticallySyncScene を ON
+    /// - Console/HUD を使わず、起動証跡をファイル出力（persistentDataPath/staging_beacon.log）
+    /// </summary>
+    public static class BootstrapShimLoader
+    {
+        private const string SURFACE_NAME = "GameFlow";
+        private const string BEACON_FILE = "staging_beacon.log";
+
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
+        private static void EnsureStableSurface()
+        {
+            // 1) シーン同期を必ずON
+            PhotonNetwork.AutomaticallySyncScene = true;
+
+            // 2) 常駐の"GameFlow"を確保
+            var surface = GameObject.Find(SURFACE_NAME);
+            if (surface == null)
+            {
+                surface = new GameObject(SURFACE_NAME);
+                Object.DontDestroyOnLoad(surface);
+            }
+
+            // 3) PunStagingFlow_Shim を確実に載せる
+            if (Object.FindObjectOfType<PunStagingFlow_Shim>() == null)
+            {
+                if (surface.GetComponent<PunStagingFlow_Shim>() == null)
+                    surface.AddComponent<PunStagingFlow_Shim>();
+            }
+
+            // 4) LoadingShellAutoLoader も確実に載せる
+            if (Object.FindObjectOfType<LoadingShellAutoLoader>() == null)
+            {
+                if (surface.GetComponent<LoadingShellAutoLoader>() == null)
+                    surface.AddComponent<LoadingShellAutoLoader>();
+            }
+
+            // 5) 起動ビーコン（ファイル）出力：Console/HUDなしで起動確認できるように
+            try
+            {
+                var path = Path.Combine(Application.persistentDataPath, BEACON_FILE);
+                File.AppendAllText(path, System.DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss") +
+                                         " :: BootstrapShimLoader.EnsureStableSurface()\n");
+            }
+            catch { /* 失敗しても動作は継続 */ }
+        }
+    }
+}
