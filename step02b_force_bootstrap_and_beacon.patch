@@ -0,0 +1,60 @@
+using UnityEngine;
+using UnityEngine.SceneManagement;
+
+namespace Net.GameFlow2
+{
+    /// <summary>
+    /// LoadingShell に入ったら、次のステージへ進めるための最小オートローダ（詳細ロジックは既存のまま）。
+    /// ここでは「常駐化」だけを担保。
+    /// </summary>
+    public sealed class LoadingShellAutoLoader : MonoBehaviour
+    {
+        private void OnEnable()
+        {
+            // 必要に応じて sceneLoaded にフック（重複防止のため一旦解除→追加）
+            SceneManager.sceneLoaded -= OnSceneLoaded;
+            SceneManager.sceneLoaded += OnSceneLoaded;
+        }
+
+        private void OnDisable()
+        {
+            SceneManager.sceneLoaded -= OnSceneLoaded;
+        }
+
+        private void OnSceneLoaded(Scene scene, LoadSceneMode mode)
+        {
+            // ここでは「LoadingShell到達の検知」だけを担当（詳細な遷移は既存の仕組みに委譲）
+            if (scene.name == "LoadingShell")
+            {
+                // 以降の進行はPunStagingFlow_Shim側の既存ロジックが拾う想定
+            }
+        }
+    }
+}
