+using UnityEngine;
+using UnityEngine.SceneManagement;
+using Photon.Pun;
+using ExitGames.Client.Photon;
+
+/// <summary>
+/// ルームに gm_plan が入っていれば LoadingShell を必ず経由させるシンプルローダー。
+/// （既存実装と重複しないよう、検出のみ：gm_plan が無いなら何もしない）
+/// </summary>
+public static class LoadingShellAutoLoader
+{
+    private const string RP_PLAN = "gm_plan";
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
+    private static void KickIfPlanExists()
+    {
+        // Editor起動直後の一瞬は部屋外なので、OnJoinedRoomで拾い直される想定。
+        if (!PhotonNetwork.InRoom) return;
+        var props = PhotonNetwork.CurrentRoom?.CustomProperties;
+        if (props == null || !props.ContainsKey(RP_PLAN)) return;
+
+        // すでに LoadingShell に居るなら何もしない
+        var active = SceneManager.GetActiveScene().name;
+        if (active == "LoadingShell") return;
+
+        Debug.Log("[AutoLoader] gm_plan detected -> Load LoadingShell");
+        SceneManager.LoadScene("LoadingShell", LoadSceneMode.Single);
+    }
+}
