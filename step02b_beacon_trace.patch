+using System;
+using System.IO;
+using System.Text;
+using UnityEngine;
+using Photon.Pun;
+using ExitGames.Client.Photon;
+
+/// <summary>
+/// コンソール/HUDを使わず、起動時点の状況を確実にファイルへ吐くビーコン。
+/// - BeforeSceneLoad で毎回1行以上出力
+/// - Unityの persistentDataPath と デスクトップ\game\デバッグ の両方へ同名で出力
+/// - さらに Debug.Log も出すので、既存の netlog_*.log にも痕跡が残る
+/// </summary>
+public static class StagingBeacon
+{
+    private const string FileName = "staging_beacon.log";
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
+    private static void WriteBootBeacon()
+    {
+        try
+        {
+            var now = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss.fff");
+            var scene = UnityEngine.SceneManagement.SceneManager.GetActiveScene().name;
+            string header = $"[BOOT] {now} scene={scene} inRoom={PhotonNetwork.InRoom} autoSync={PhotonNetwork.AutomaticallySyncScene}";
+
+            // 出力先1: persistentDataPath
+            var p1 = Path.Combine(Application.persistentDataPath, FileName);
+            // 出力先2: デスクトップ\game\デバッグ
+            var desktop = Environment.GetFolderPath(Environment.SpecialFolder.DesktopDirectory);
+            var p2 = Path.Combine(desktop, "game", "デバッグ", FileName);
+
+            Directory.CreateDirectory(Path.GetDirectoryName(p1)!);
+            Directory.CreateDirectory(Path.GetDirectoryName(p2)!);
+
+            AppendLineSafe(p1, header);
+            AppendLineSafe(p2, header);
+
+            // 参考：部屋プロパティのキーだけでも残す（まだ部屋外なら空）
+            var keys = PhotonNetwork.CurrentRoom?.CustomProperties?.Keys;
+            string keyList = (keys == null) ? "(no-room)" : string.Join(",", keys);
+            AppendLineSafe(p1, "[ROOM_KEYS] " + keyList);
+            AppendLineSafe(p2, "[ROOM_KEYS] " + keyList);
+
+            Debug.Log($"[Beacon] wrote to: {p1} | {p2}");
+        }
+        catch (Exception ex)
+        {
+            Debug.LogError("[Beacon] write failed: " + ex);
+        }
+    }
+
+    private static void AppendLineSafe(string path, string line)
+    {
+        using (var fs = new FileStream(path, FileMode.Append, FileAccess.Write, FileShare.ReadWrite))
+        using (var sw = new StreamWriter(fs, new UTF8Encoding(false)))
+        {
+            sw.WriteLine(line);
+        }
+    }
+}
